{
  "name": "instagram-chatkit",
  "version": "3.1.1",
  "description": "Instagram messaging library for Node.js",
  "author": {
    "name": "Thiệu Trung Kiên",
    "url": "https://github.com/ttkienn"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ttkienn/instagram-chatkit.git"
  },
  "homepage": "https://github.com/ttkienn/instagram-chatkit#readme",
  "bugs": {
    "url": "https://github.com/ttkienn/instagram-chatkit/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "main": "./src/index.js",
  "types": "./types/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.js"
    },
    "./bot": {
      "types": "./types/bot.d.ts",
      "default": "./src/bot/index.js"
    },
    "./advanced": {
      "types": "./types/advanced.d.ts",
      "default": "./src/advanced.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "types",
    "examples",
    "docs",
    "scripts/set-private-permissions.ps1",
    "config.example.json",
    "README.md",
    "README.vi.md",
    "assets",
    "LICENSE",
    "licenses"
  ],
  "scripts": {
    "example:bot": "node examples/optional/bot.js",
    "check": "node scripts/check.js",
    "check:types": "tsc --project scripts/fixtures/tsconfig.json",
    "check:package": "node scripts/check-package.js",
    "verify": "npm run check && npm run check:types && npm run check:package",
    "prepublishOnly": "npm run verify"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "mqtt": "5.16.1",
    "ws": "8.22.1"
  },
  "devDependencies": {
    "typescript": "7.0.2"
  }
}
